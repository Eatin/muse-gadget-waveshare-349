tmp/
build/
build-*/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
.cache/
*.o
*.a


.claude/

# Your own avatar (tools/muse/AVATAR_RECIPE.md): built when present, never committed.
components/muse/avatar/
# tools/muse/make_gifs.py's default output directory.
/gifs/

# Local debug artifacts (not tracked).
*.log
logs.logs

# ESP-IDF Installation Manager config — machine-specific install paths.
eim_config.toml

# Secure Boot signing keys — materialized in CI from secrets, never committed.
release_signing_key.pem
factory_test_signing_key.pem

.DS_Store

# Python test bytecode
__pycache__/
*.pyc

# Android / Gradle build artifacts
.gradle/
.idea/
local.properties

# Local Wi-Fi and API credentials for the Waveshare ESP32-S3-Touch-LCD-3.49
# port.  This file is a copy of devices/sdkconfig.waveshare-s3-lcd-349 with the
# iFlytek APPID/APIKey/APISecret, the SenseNova key and the Wi-Fi passphrase
# filled in; tools/board.sh loads it last, on top of the committed profile.
# Never commit it:
#   cp devices/sdkconfig.waveshare-s3-lcd-349 \
#      devices/sdkconfig.muse-waveshare-s3-lcd-349
devices/sdkconfig.muse-waveshare-s3-lcd-349
# Any other local overlay the reader keeps beside it.
devices/sdkconfig.*.local
